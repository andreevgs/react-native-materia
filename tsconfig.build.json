{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "isolatedModules": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "example",
    "**/__tests__",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
